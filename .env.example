# Supabase Configuration
# Get these values from your Supabase project settings at https://app.supabase.com

# Public API Key (safe to expose in frontend)
VITE_SUPABASE_PUBLISHABLE_KEY=your_public_key_here

# Service Role Key (KEEP SECRET - only use in backend/scripts)
# DO NOT EXPOSE IN FRONTEND OR VERSION CONTROL
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Project URL
VITE_SUPABASE_URL=your_project_url_here

# Project ID
VITE_SUPABASE_PROJECT_ID=your_project_id_here

# Admin Access Token
# This token is used to access the secure admin login page
# Access URL: https://yourdomain.com/secure-admin/YOUR_TOKEN_HERE
# IMPORTANT: Keep this secret and use a strong, random string
VITE_ADMIN_ACCESS_TOKEN=your_secure_random_token_here
